{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build pk3",
      "type": "shell",
      "command": "7z a -tzip ../../${workspaceFolderBasename}.pk3",
      "options": {
        "cwd": "${workspaceFolder}/src"
      }
    },
    {
      "label": "launch selaco",
      "type": "shell",
      "dependsOn": [ "build pk3" ],
      "command": "Start-Process 'steam://rungameid/1592280'",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
